<div class="mb-3"><label asp-for="DanhMucChaId" class="form-label">Danh mục cha</label><select asp-for="DanhMucChaId" asp-items="ViewBag.DanhMucChaId" class="form-select"><option value="">-- Không có --</option></select></div>
