@model IEnumerable<BoThucHanh>
<div class="container py-5"><div class="d-flex justify-content-between mb-3"><h1>Bộ thực hành</h1><a asp-action="Create" class="btn btn-primary">Thêm bộ</a></div><table class="table table-bordered bg-white"><thead><tr><th>Mã</th><th>Tên</th><th>Số thành phần</th><th>Kích hoạt</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.MaBo</td><td>@x.TenBo</td><td>@x.ThanhPhans.Count</td><td>@(x.KichHoat ? "Có" : "Không")</td><td><a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Sửa</a> <a asp-action="ThanhPhan" asp-route-id="@x.Id" class="btn btn-sm btn-outline-success">Thành phần</a></td></tr>}</tbody></table></div>
