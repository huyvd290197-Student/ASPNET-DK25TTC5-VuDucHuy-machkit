@model BoThucHanh
<div class="container py-5"><h1>Thành phần: @Model.TenBo</h1><form asp-action="ThemThanhPhan" method="post" class="row g-2 mb-4"><input type="hidden" name="boId" value="@Model.Id" /><div class="col-md-7"><select name="linhKienId" asp-items="ViewBag.LinhKienId" class="form-select"></select></div><div class="col-md-3"><input name="soLuong" type="number" min="1" value="1" class="form-control" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Thêm/Cập nhật</button></div></form><table class="table table-bordered bg-white"><thead><tr><th>Linh kiện</th><th>Số lượng / bộ</th><th></th></tr></thead><tbody>@foreach(var x in Model.ThanhPhans){<tr><td>@x.LinhKien?.TenLinhKien</td><td>@x.SoLuong</td><td><form asp-action="XoaThanhPhan" method="post"><input type="hidden" name="boId" value="@Model.Id" /><input type="hidden" name="linhKienId" value="@x.LinhKienId" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
