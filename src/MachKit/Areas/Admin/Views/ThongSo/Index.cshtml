@model IEnumerable<ThongSoKyThuat>
@{ var lk = (LinhKien)ViewBag.LinhKien; ViewData["Title"]="Thông số kỹ thuật"; }
<div class="container py-5"><h1>Thông số: @lk.TenLinhKien</h1><form asp-action="Create" method="post" class="row g-2 mb-4"><input type="hidden" name="linhKienId" value="@lk.Id" /><div class="col-md-4"><input name="tenThongSo" class="form-control" placeholder="Tên thông số" required /></div><div class="col-md-4"><input name="giaTri" class="form-control" placeholder="Giá trị" required /></div><div class="col-md-2"><input name="donVi" class="form-control" placeholder="Đơn vị" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Thêm</button></div></form><table class="table table-bordered bg-white"><thead><tr><th>Tên</th><th>Giá trị</th><th>Đơn vị</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TenThongSo</td><td>@x.GiaTri</td><td>@x.DonVi</td><td><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table><a asp-controller="LinhKien" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
