@using Microsoft.AspNetCore.Identity
@using MachKit.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav ms-lg-3">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
    {
        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Quản trị</a></li>
    }
    <li class="nav-item"><span class="nav-link">@User.Identity?.Name</span></li>
    <li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button type="submit" class="btn btn-link nav-link">Đăng xuất</button></form></li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
    <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
}
</ul>
